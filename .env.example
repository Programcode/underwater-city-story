# ── ElevenLabs voices + sound effects (optional) ────────────────────────────
# Add a key to give the narrator and characters real voices and mood SFX.
# Leave blank to keep the game on procedural ambience only (still works).
#
# Requests are routed through the Vite dev/preview proxy (/eleven), which injects
# this key server-side — so there is NO CORS issue and the key is NOT shipped in
# the client bundle. Either of these names works:
ELEVENLABS_API_KEY=
# VITE_ELEVENLABS_API_KEY=

# Optional: TTS model (default: eleven_turbo_v2_5 — low latency, English).
# Use eleven_multilingual_v2 for higher quality at the cost of latency.
VITE_ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: audio output format (default: mp3_44100_128).
VITE_ELEVENLABS_OUTPUT=mp3_44100_128

# Optional: override the voice id used for each speaker (voice ids are not
# secret). Copy ids from ElevenLabs → Voices → "..." → Copy voice ID.
VITE_ELEVENLABS_VOICE_NARRATOR=
VITE_ELEVENLABS_VOICE_MIRA=
VITE_ELEVENLABS_VOICE_OCEAN=
VITE_ELEVENLABS_VOICE_TORIN=
VITE_ELEVENLABS_VOICE_VEYR=

# NOTE: After editing this file, restart `npm run dev` (Vite reads env at startup).
