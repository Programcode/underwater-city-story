# ── ElevenLabs voices (optional) ────────────────────────────────────────────
# Add a key to give the narrator and characters real voices. Leave blank to
# keep the game silent (everything still works without it).
#
# SECURITY: VITE_ vars are bundled into the client, so this key is visible to
# anyone who loads the app. That is fine for local/demo use. For a public
# deployment, proxy these requests through a small backend that holds the key.
VITE_ELEVENLABS_API_KEY=

# Optional: TTS model (default: eleven_turbo_v2_5 — low latency, English).
# Use eleven_multilingual_v2 for higher quality at the cost of latency.
VITE_ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: override the voice id used for each speaker. Pick any voice id from
# your ElevenLabs voice library (Voices → "..." → Copy voice ID). Defaults are
# tuned ElevenLabs premade voices.
VITE_ELEVENLABS_VOICE_NARRATOR=
VITE_ELEVENLABS_VOICE_MIRA=
VITE_ELEVENLABS_VOICE_OCEAN=
VITE_ELEVENLABS_VOICE_TORIN=
VITE_ELEVENLABS_VOICE_VEYR=
