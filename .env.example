# ── ElevenLabs voices + sound effects (optional) ────────────────────────────
# The shipped game already plays pre-rendered files in public/audio/.
# A key is only needed to regenerate those files (`npm run audio`) or to
# synthesize missing lines through the dev server.
#
# Put the key in .env.local (gitignored) under this name:
ELEVENLABS_API_KEY=
#
# Keep the key off any VITE_ name. Vite inlines VITE_ variables into client
# code wherever they are read. The dev server reads ELEVENLABS_API_KEY and
# calls ElevenLabs from the `/api/eleven` route.

# Optional: TTS model used by the dev proxy and by `npm run audio`.
# The committed clips were rendered with eleven_v3.
VITE_ELEVENLABS_MODEL=eleven_v3

# Optional: audio output format (default: mp3_44100_128).
VITE_ELEVENLABS_OUTPUT=mp3_44100_128

# Optional: override the voice id used for each speaker (voice ids are not
# secret). Copy ids from ElevenLabs → Voices → "..." → Copy voice ID.
VITE_ELEVENLABS_VOICE_NARRATOR=
VITE_ELEVENLABS_VOICE_MIRA=
VITE_ELEVENLABS_VOICE_OCEAN=
VITE_ELEVENLABS_VOICE_TORIN=
VITE_ELEVENLABS_VOICE_VEYR=

# NOTE: After editing this file, restart `npm run dev` (Vite reads env at startup).
